# ── Dhan (Indian stocks — https://dhanhq.co) ─────────────────────
DHAN_CLIENT_ID=your_dhan_client_id
DHAN_ACCESS_TOKEN=your_dhan_access_token

# ── Binance (Crypto — keys OPTIONAL, public market data needs none) ─
BINANCE_API_KEY=
BINANCE_API_SECRET=
# BINANCE_BASE_URL=https://api.binance.com

# ── Telegram (create a bot with @BotFather, get chat id from @userinfobot) ─
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
TELEGRAM_CHAT_ID=your_chat_id

# ── Discord (Server Settings → Integrations → Webhooks) ──────────
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxx/yyyy

# ── Built-in market scanner (auto top-50 by volume + indexes) ────
SCANNER_ENABLED=true
SCANNER_TOP_N=50
SCANNER_INTERVAL_SEC=120
SCANNER_IMBALANCE_THRESHOLD=0.4
SCANNER_INDEX_MOVE_PCT=1.0
SCANNER_COOLDOWN_SEC=900
SCANNER_NOTIFY=true
SCANNER_CHANNELS=telegram,discord

# ── App ──────────────────────────────────────────────────────────
FLASK_SECRET_KEY=change-me
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
RESPECT_MARKET_HOURS=true
